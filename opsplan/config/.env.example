# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01

# Azure Blob Storage
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_BLOB_CONTAINER=opsplan-data

# Azure AI Vision (Part 2)
AZURE_VISION_ENDPOINT=https://your-vision.cognitiveservices.azure.com/
AZURE_VISION_API_KEY=your-key-here

# Azure Communication Services (Notifications)
AZURE_COMM_CONNECTION_STRING=endpoint=https://your-comm.communication.azure.com/;accesskey=...
AZURE_COMM_SENDER_EMAIL=alerts@opsplan.io
AZURE_COMM_SENDER_PHONE=+1XXXXXXXXXX
ACS_EVENTGRID_TOPIC_KEY=
ACS_SMS_WEBHOOK_SECRET=

# Microsoft Graph (Inbound Email)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX_USER_ID=
GRAPH_NOTIFICATION_CLIENT_STATE=
GRAPH_SUBSCRIPTION_CALLBACK_URL=

# Census API (free key)
CENSUS_API_KEY=your-census-key-here

# Database
DATABASE_PATH=data/opsplan.db

# App
LOG_LEVEL=INFO
DEBUG=false
INBOUND_AUTO_PARSE=false
